          "after": [
            101
          ]
        },
        {
          "field": "rollout_percent",
          "before": 50,
          "after": 80
        }
      ],
      "risk": "high",
      "direction": "mixed",
      "confirm": {
        "reason_required": true,
        "checkbox_required": true,
        "type_to_confirm": null
      },
      "current_rev": 4,
      "rev_stale": false,
      "effective_preview": {
