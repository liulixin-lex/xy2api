{
  "_contract": [
    "M3-2",
    "C-4"
  ],
  "_note": "M3 方向样例 mixed：rollout 50→80 为扩大，account_ids 从 [101,102] 改为 [101]（移除 102）为收窄。两者同时出现即 mixed，按非 disable 方向处理：要求理由与勾选。v1.0.1：diff 的 before 更正为与 m3_list_on 同一 rev 4 的存储值 [101,102]（请求不变）。",
  "request": {
    "method": "POST",
    "path": "/api/v1/admin/cache/policies/upstream_identity/validate",
    "body": {
      "expected_rev": 4,
      "spec": {
        "rollout_percent": 80,
        "account_ids": [
          101
        ]
      },
      "reason": "比例调高，但只限一个账号",
      "confirm": {
        "checkbox": true,
        "typed": null
      }
    }
  },
  "status": 200,
  "response": {
    "code": 0,
    "message": "success",
    "data": {
      "valid": true,
      "errors": [],
      "warnings": [],
