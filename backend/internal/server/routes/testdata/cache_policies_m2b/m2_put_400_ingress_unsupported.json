{
  "_contract": [
    "P-M2",
    "C-6"
  ],
  "_note": "仅 M2 构建：ingress_chain_percent 取非默认值时，PUT 返回 400 CACHE_POLICY_UNSUPPORTED，metadata.errors 的格式与 INVALID 相同。",
  "request": {
    "method": "PUT",
    "path": "/api/v1/admin/cache/policies/observability",
    "body": {
      "expected_rev": 2,
      "spec": {
        "ingress_chain_percent": 20
      },
      "reason": "提高入站链采样"
    }
  },
  "status": 400,
  "response": {
    "code": 400,
    "message": "cache policy validation failed",
    "reason": "CACHE_POLICY_UNSUPPORTED",
    "metadata": {
      "errors": "[{\"field\":\"ingress_chain_percent\",\"code\":\"unsupported_in_build\"}]"
    }
  }
}
