{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://schemas.xy2api.invalid/cache_trace/v1-l09a.json",
 "title": "cache_trace v=1 线上事件载荷 · T3.1a 追加（L-09a 同 host 重选偏好）",
 "description": "在 m31 之上：OpenAI admitted 事件必有 l09a_arm、l09a_applied、l09a_skip。route_reason 的枚举不变（affinity_pref 不启用）。v 仍为 1。见 l09a/README.md。",
 "oneOf": [
  {
   "$ref": "#/$defs/rejected"
  },
  {
   "$ref": "#/$defs/admitted"
  }
 ],
 "$defs": {
  "rejected": {
   "description": "最小事件：loss_class=n/a_sampled_out 且 na_reason ∈ {budget_full, expired, not_ready, observer_failed, undelivered}。只含关联键、计量值与分段所需的同步字段。observer_failed（v1.7.8.2）在 observer panic 或返回错误、trace 被丢弃时，由结算处根据独立的失败标记输出。undelivered（v1.7.8.6）用于有上游尝试、客户端在任何输出前断开、但已结算（例如按 abuse 规则计费）的请求，不参与损失归因。",
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "v": {
     "const": 1
    },
    "platform": {
     "type": "string",
     "enum": [
      "openai"
     ]
    },
    "loss_class": {
     "const": "n/a_sampled_out"
    },
    "na_reason": {
     "type": "string",
     "enum": [
      "budget_full",
      "expired",
      "not_ready",
      "observer_failed",
      "undelivered"
     ]
    },
    "request_id_hmac": {
     "type": "string",
     "pattern": "^[0-9a-f]{12,64}$"
    },
    "session_digest": {
     "type": "string",
     "anyOf": [
      {
       "pattern": "^v2:[0-9a-f]{16}$"
      },
      {
       "pattern": "^[0-9a-f]{16}$"
      },
      {
       "const": ""
      }
     ]
    },
    "account_id": {
     "type": "integer",
     "minimum": 0
    },
    "group_id": {
     "type": "integer",
     "minimum": 0
    },
    "P": {
     "type": "integer",
     "minimum": 0
    },
    "read": {
     "type": "integer",
     "minimum": 0
    },
    "pol_rev": {
     "type": "string",
     "pattern": "^m[0-9]{1,19}\\.o[0-9]{1,19}\\.u[0-9]{1,19}\\.a[0-9]{1,19}\\.r[0-9]{1,19}$"
    },
    "ua_family": {
     "type": "string",
     "enum": [
      "codex_cli_rs",
      "codex_tui",
      "codex_desktop",
      "codex_exec",
      "codex_vscode",
      "codex_other",
      "litellm",
      "go_http",
      "openai_sdk",
      "other"
     ]
    }
   },
   "required": [
    "v",
    "platform",
    "loss_class",
    "na_reason",
    "request_id_hmac",
    "session_digest",
    "account_id",
    "group_id",
    "P",
    "read",
    "pol_rev",
    "ua_family"
   ]
  },
  "admitted": {
   "description": "完整事件：除上述三种拒绝原因之外的全部情形（含 n/a_plugin、n/a_usage、n/a_truncated、chain_percent 与 hist_unavailable 的 n/a_sampled_out）。",
