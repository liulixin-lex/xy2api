[Unit]
Description=XY2API Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=xy2api
Group=xy2api
WorkingDirectory=/opt/xy2api
ExecStart=/opt/xy2api/datamanagementd \
  -socket-path /tmp/xy2api-datamanagement.sock \
  -sqlite-path /var/lib/xy2api/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
