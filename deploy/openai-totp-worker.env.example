# Copy to a private environment file outside the checkout; chmod 0600.
XY2API_OPENAI_TOTP_API_URL=http://127.0.0.1:8080
# Generate a random >=32-character secret, and use the same value on the API.
XY2API_OPENAI_TOTP_WORKER_SECRET=
XY2API_OPENAI_TOTP_WORKER_ID=totp-worker-1
TOSUB2_ROOT=/opt/xy2api-totp/tosub2
OPENAI_TOTP_JOURNAL_DIR=/var/lib/xy2api-totp/journal
NODE_EXECUTABLE=/usr/bin/node
XY2API_OPENAI_TOTP_POLL_SECONDS=5
XY2API_OPENAI_TOTP_HEARTBEAT_SECONDS=10
XY2API_OPENAI_TOTP_REQUEST_TIMEOUT=10
